{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Laravel API",
      "type": "php",
      "request": "launch",
      "port": 9003,
      "pathMappings": {
        "${workspaceRoot}/backend": "${workspaceRoot}/backend"
      }
    },
    {
      "name": "Debug Angular Frontend",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceRoot}/frontend"
    }
  ]
}